[
  {
    "id": "orchis",
    "name": "Orchis",
    "category": "gtk-theme",
    "thumbnail": "assets/previews/orchis.png",
    "author": "vinceliuice",
    "source_url": "https://github.com/vinceliuice/Orchis-theme",
    "license": "GPL-3.0",
    "install_type": "script",
    "source": { "type": "git", "repo": "https://github.com/vinceliuice/Orchis-theme.git" },
    "variants": {
      "color": ["default", "purple", "pink", "red", "orange", "yellow", "green", "teal", "grey", "all"],
      "mode": ["dark", "light", "standard"],
      "size": ["standard", "compact"],
      "tweaks": ["none", "solid", "compact", "black", "primary", "macos", "submenu", "nord", "dracula", "dock"],
      "icon": ["default", "apple", "gnome", "ubuntu", "arch", "fedora", "debian", "manjaro"]
    },
    "install_script": "./install.sh",
    "install_args_template": "-t {color} -c {mode} -s {size} {tweaks} {icon} -l",
    "dependencies": ["sassc"],
    "target_dir": "~/.themes",
    "gtk4_fix": true,
    "gdm_eligible": true,
    "notes": "Orchis official script supports color, mode, size, tweaks, and panel icon variants."
  },
  {
    "id": "whitesur-gtk-theme",
    "name": "WhiteSur",
    "category": "gtk-theme",
    "thumbnail": "assets/previews/whitesur.png",
    "author": "vinceliuice",
    "source_url": "https://github.com/vinceliuice/WhiteSur-gtk-theme",
    "license": "MIT",
    "install_type": "script",
    "source": { "type": "git", "repo": "https://github.com/vinceliuice/WhiteSur-gtk-theme.git" },
    "variants": {
      "color": ["default", "blue", "purple", "pink", "red", "orange", "yellow", "green", "grey", "all"],
      "mode": ["dark", "light"],
      "opacity": ["normal", "solid"],
      "alt": ["normal", "alt"],
      "scheme": ["standard", "nord"],
      "icon": ["apple", "simple", "gnome", "ubuntu", "tux", "arch", "manjaro", "fedora", "debian"],
      "nautilus": ["stable", "normal", "mojave", "glassy", "right"]
    },
    "install_script": "./install.sh",
    "install_args_template": "-t {color} -c {mode} -o {opacity} -a {alt} -s {scheme} {icon} -N {nautilus} -d {dest_dir} -l",
    "dependencies": ["sassc", "glib-compile-schemas"],
    "target_dir": "~/.themes",
    "gtk4_fix": true,
    "gdm_eligible": true,
    "notes": "MacOS Big Sur and Monterey style theme for GTK 2/3/4 and GNOME Shell with rich customization."
  },
  {
    "id": "dracula-gtk",
    "name": "Dracula",
    "category": "gtk-theme",
    "thumbnail": "assets/previews/dracula.png",
    "author": "Dracula Theme",
    "source_url": "https://github.com/dracula/gtk",
    "license": "GPL-3.0",
    "install_type": "zip-static",
    "source": {
      "type": "zip",
      "zip_url": "https://github.com/dracula/gtk/releases/download/v4.0.0/Dracula.tar.xz",
      "variant_urls": {
        "standard": "https://github.com/dracula/gtk/releases/download/v4.0.0/Dracula.tar.xz",
        "pink": "https://github.com/dracula/gtk/releases/download/v4.0.0/Dracula-pink-accent.tar.xz"
      }
    },
    "variants": {
      "accent": [
        "standard",
        "pink"
      ]
    },
    "target_dir": "~/.themes",
    "gtk4_fix": true,
    "gdm_eligible": true,
    "notes": "The official Dracula dark theme for GTK 2/3/4 and Libadwaita with iconic purple and pink neon accents."
  },
  {

    },
    "variants": {
      "color": [
        "default",
        "blue",
        "purple",
        "pink",
        "red",
        "orange",
        "yellow",
        "green",
        "grey",
        "all"
      ],
      "mode": [
        "dark",
        "light"
      ],
      "opacity": [
        "normal",
        "solid"
      ],
      "alt": [
        "normal",
        "alt"
      ],
      "scheme": [
        "standard",
        "nord"
      ],
      "icon": [
        "apple",
        "simple",
        "gnome",
        "ubuntu",
        "tux",
        "arch",
        "manjaro",
        "fedora",
        "debian"
      ]
    },
    "install_script": "./install.sh",
    "install_args_template": "-t {color} -c {mode} -o {opacity} -a {alt} -s {scheme} --shell -i {icon} -d {dest_dir}",
